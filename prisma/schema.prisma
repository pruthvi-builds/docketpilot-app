// DocketPilot data model — Postgres (works locally with a free Neon/Supabase/
// Vercel Postgres instance, and is what production runs on since Vercel's
// filesystem is ephemeral and can't hold a SQLite file across deploys).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are validated in application code (lib/auth.ts, API routes) against
// "ADMIN" | "ATTORNEY" | "STAFF" rather than a native DB enum, so switching
// datasource providers (sqlite/postgresql/mysql) never requires a schema change here.
model Firm {
  id                 String   @id @default(cuid())
  name               String
  plan               String   @default("trial") // trial | active | canceled
  paymentCustomerId     String? // Paddle customer_id
  paymentSubscriptionId String? // Paddle subscription_id
  reminderDaysBefore String   @default("30,14,7,1") // comma-separated day offsets
  onboardingDismissed Boolean @default(false)
  createdAt          DateTime @default(now())

  users   User[]
  cases   Case[]
  activity ActivityLog[]
  tasks   Task[]
  documents Document[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ATTORNEY")
  firmId       String
  firm         Firm     @relation(fields: [firmId], references: [id])
  createdAt    DateTime @default(now())
}

model Case {
  id         String   @id @default(cuid())
  firmId     String
  firm       Firm     @relation(fields: [firmId], references: [id])
  clientName String
  caseNumber String?
  court      String?
  caseType   String?
  status     String   @default("OPEN") // OPEN | CLOSED
  createdAt  DateTime @default(now())

  deadlines Deadline[]
  tasks     Task[]
  documents Document[]

  @@index([firmId])
}

model Deadline {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              String   // Filing Deadline | Hearing Date | Statute of Limitations | Discovery Cutoff | Other
  dueDate           DateTime
  notes             String?
  completed         Boolean  @default(false)
  completedAt       DateTime? // set automatically when `completed` flips true; cleared if reopened
  remindersSentDays String   @default("") // comma-separated day offsets already emailed
  createdAt         DateTime @default(now())

  @@index([caseId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id])
  userId    String?
  action    String   // e.g. "case.created", "deadline.updated", "reminder.sent"
  detail    String?
  createdAt DateTime @default(now())

  @@index([firmId])
}

model Task {
  id        String    @id @default(cuid())
  firmId    String
  firm      Firm      @relation(fields: [firmId], references: [id])
  caseId    String?
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title     String
  priority  String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([firmId])
  @@index([caseId])
}

model Document {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id])
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filename    String
  pathname    String   // Vercel Blob pathname, e.g. "documents/<caseId>/<cuid>-<filename>"
  contentType String?
  size        Int
  uploadedAt  DateTime @default(now())

  @@index([firmId])
  @@index([caseId])
}

// Public lead-capture for firms interested in an eventual Enterprise/BigLaw
// tier (SSO, per-matter permissions, security review). No auth required to
// submit — this is a marketing waitlist, not a tenant.
model EnterpriseLead {
  id        String   @id @default(cuid())
  firmName  String
  email     String
  firmSize  String?
  message   String?
  createdAt DateTime @default(now())
}

// Web Push (VAPID) subscriptions for browser deadline-reminder notifications —
// a free alternative to paid SMS reminders. One row per browser/device a user
// has enabled notifications on; endpoint is the browser's unique push URL.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

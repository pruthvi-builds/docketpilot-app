// DocketPilot data model — Postgres (works locally with a free Neon/Supabase/
// Vercel Postgres instance, and is what production runs on since Vercel's
// filesystem is ephemeral and can't hold a SQLite file across deploys).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are validated in application code (lib/auth.ts, API routes) against
// "ADMIN" | "ATTORNEY" | "STAFF" rather than a native DB enum, so switching
// datasource providers (sqlite/postgresql/mysql) never requires a schema change here.
model Firm {
  id                 String   @id @default(cuid())
  name               String
  plan               String   @default("trial") // trial | active | canceled
  paymentCustomerId     String? // Dodo Payments customer_id
  paymentSubscriptionId String? // Dodo Payments subscription_id
  reminderDaysBefore String   @default("30,14,7,1") // comma-separated day offsets
  createdAt          DateTime @default(now())

  users   User[]
  cases   Case[]
  activity ActivityLog[]
  tasks   Task[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ATTORNEY")
  firmId       String
  firm         Firm     @relation(fields: [firmId], references: [id])
  createdAt    DateTime @default(now())
}

model Case {
  id         String   @id @default(cuid())
  firmId     String
  firm       Firm     @relation(fields: [firmId], references: [id])
  clientName String
  caseNumber String?
  court      String?
  caseType   String?
  status     String   @default("OPEN") // OPEN | CLOSED
  createdAt  DateTime @default(now())

  deadlines Deadline[]
  tasks     Task[]

  @@index([firmId])
}

model Deadline {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              String   // Filing Deadline | Hearing Date | Statute of Limitations | Discovery Cutoff | Other
  dueDate           DateTime
  notes             String?
  completed         Boolean  @default(false)
  remindersSentDays String   @default("") // comma-separated day offsets already emailed
  createdAt         DateTime @default(now())

  @@index([caseId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id])
  userId    String?
  action    String   // e.g. "case.created", "deadline.updated", "reminder.sent"
  detail    String?
  createdAt DateTime @default(now())

  @@index([firmId])
}

model Task {
  id        String    @id @default(cuid())
  firmId    String
  firm      Firm      @relation(fields: [firmId], references: [id])
  caseId    String?
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title     String
  priority  String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([firmId])
  @@index([caseId])
}

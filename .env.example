# Database — Postgres. Free options: Neon (neon.tech), Vercel Postgres, or Supabase.
# Vercel's Postgres/Neon integration auto-injects this when added to your project.
DATABASE_URL="postgresql://user:password@host:5432/docketpilot"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Outbound email for deadline reminders (optional at first — app runs fine without it,
# reminder emails just get logged to the server console instead of sent).
# Works with Gmail app passwords, Resend SMTP, Postmark SMTP, SES SMTP, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DocketPilot <reminders@yourdomain.com>"

# Secret required in the Authorization header when the daily reminder cron hits
# /api/cron/send-reminders (set the same value in Vercel Cron / your scheduler)
CRON_SECRET="change-this-too"

# Paddle billing (Merchant of Record — supports India-based individuals with
# no registered company and no upfront cost, unlike Stripe/Razorpay. Optional —
# Settings > Billing will show a setup message until these are set).
# Server-side (Developer Tools > Authentication > API keys):
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# Client-side, safe to expose in the browser (Developer Tools > Authentication
# > Client-side tokens, and Catalog > Products > your price ID):
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_PRICE_ID=""
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# Public site URL, used in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (SQLite file works out of the box; swap DATABASE_URL for Postgres in production)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Outbound email for deadline reminders (optional at first — app runs fine without it,
# reminder emails just get logged to the server console instead of sent).
# Works with Gmail app passwords, Resend SMTP, Postmark SMTP, SES SMTP, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DocketPilot <reminders@yourdomain.com>"

# Secret required in the Authorization header when the daily reminder cron hits
# /api/cron/send-reminders (set the same value in Vercel Cron / your scheduler)
CRON_SECRET="change-this-too"

# Dodo Payments billing (Merchant of Record — works for India-based sellers,
# no monthly fee, pay-per-transaction only. Optional — Settings > Billing will
# show a setup message until these are set). Get these from your Dodo
# Payments dashboard: Developer > API Keys, and Developer > Webhooks.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PRODUCT_ID=""
DODO_WEBHOOK_SECRET=""

# Public site URL, used in emails and Dodo Payments redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
